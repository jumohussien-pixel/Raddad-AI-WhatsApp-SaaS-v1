# ==============================================================================
# Multi-Tenant Enterprise AI WhatsApp SaaS Engine - Environment Variables
# ==============================================================================

# Server Configuration
PORT=3000
NODE_ENV=production
APP_URL=https://your-domain.run.app

# Gemini AI Engine (Google Gen AI SDK)
GEMINI_API_KEY=your_gemini_api_key_here

# Meta Cloud API (Official WhatsApp Business API)
META_WA_TOKEN=your_meta_access_token_here
META_PHONE_NUMBER_ID=your_meta_phone_number_id_here
WEBHOOK_VERIFY_TOKEN=egypt_saas_secure_token_2026

# Green API Gateway (Alternative WhatsApp Provider / QR Instance)
GREEN_API_INSTANCE_ID=your_green_api_instance_id_here
GREEN_API_TOKEN=your_green_api_token_here
GREEN_API_HOST=https://7105.api.greenapi.com

# Active WhatsApp Provider ('green_api' | 'meta' | 'whapi')
WHATSAPP_API_PROVIDER=green_api
